generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ListingStatus {
  ACTIVE
  CLOSED
}

enum TripStatus {
  PLANNED
  CANCELLED
  COMPLETED
}

model User {
  id                     String            @id @default(uuid())
  email                  String            @unique
  passwordHash           String
  displayName            String
  role                   UserRole          @default(USER)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  profile                UserProfile?
  motorcycles            Motorcycle[]
  posts                  Post[]            @relation("PostAuthor")
  friendRequestsSent     FriendRequest[]   @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[]   @relation("FriendRequestReceiver")
  friendshipsA           Friendship[]      @relation("FriendshipA")
  friendshipsB           Friendship[]      @relation("FriendshipB")
  communitiesOwned       Community[]       @relation("CommunityOwner")
  communityMemberships   CommunityMember[]
  listings               Listing[]         @relation("ListingSeller")
  tripsOrganized         Trip[]            @relation("TripOrganizer")
  tripParticipations     TripParticipant[]
  placesCreated          Place[]           @relation("PlaceCreator")
}

model UserProfile {
  userId      String   @id
  bio         String   @default("")
  city        String   @default("")
  ridingStyle String   @default("")
  avatarUrl   String?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Motorcycle {
  id        String   @id @default(uuid())
  ownerId   String
  make      String
  model     String
  year      Int?
  mileage   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

model Post {
  id          String     @id @default(uuid())
  authorId    String
  communityId String?
  content     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  author      User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([communityId, createdAt])
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  sender     User                @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Community {
  id          String            @id @default(uuid())
  ownerId     String
  name        String
  description String            @default("")
  city        String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       Post[]

  @@index([name])
}

model CommunityMember {
  communityId String
  userId      String
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId])
}

model Listing {
  id          String        @id @default(uuid())
  sellerId    String
  title       String
  description String        @default("")
  category    String
  price       Decimal       @db.Decimal(12, 2)
  condition   String        @default("used")
  city        String        @default("")
  imageUrl    String?
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  seller      User          @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, category, createdAt])
  @@index([city, status])
}

model Trip {
  id           String            @id @default(uuid())
  organizerId  String
  title        String
  description  String            @default("")
  startsAt     DateTime
  status       TripStatus        @default(PLANNED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  organizer    User              @relation("TripOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  waypoints    TripWaypoint[]
  participants TripParticipant[]

  @@index([startsAt, status])
}

model TripWaypoint {
  id        String  @id @default(uuid())
  tripId    String
  placeId   String?
  sequence  Int
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  label     String  @default("")
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place     Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@unique([tripId, sequence])
}

model TripParticipant {
  tripId   String
  userId   String
  joinedAt DateTime @default(now())
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
}

model Place {
  id            String         @id @default(uuid())
  creatorId     String?
  name          String
  category      String
  description   String         @default("")
  city          String         @default("")
  latitude      Decimal        @db.Decimal(9, 6)
  longitude     Decimal        @db.Decimal(9, 6)
  createdAt     DateTime       @default(now())
  creator       User?          @relation("PlaceCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  tripWaypoints TripWaypoint[]

  @@index([category, city])
}
